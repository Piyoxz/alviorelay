# AlvioRelay Environment Variables Configuration
ALVIO_NODE_ID=alvio-node-01
ALVIO_BIND_ADDRESS=0.0.0.0
ALVIO_HTTP_PORT=7880
ALVIO_LOG_LEVEL=info

# WebRTC & Media Ports
ALVIO_RTC_UDP_PORT=7882
ALVIO_RTC_EXTERNAL_IP=

# Authentication (no_auth, jwt, api_key)
ALVIO_AUTH_PROVIDER=no_auth
ALVIO_AUTH_SECRET_KEY=

# Egress & Storage
ALVIO_EGRESS_ENABLED=false
ALVIO_STORAGE_BACKEND=local
ALVIO_STORAGE_PATH=./recordings

# Webhooks
ALVIO_WEBHOOKS_ENABLED=false
ALVIO_WEBHOOK_URL=
ALVIO_WEBHOOK_SECRET=
