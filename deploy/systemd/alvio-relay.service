[Unit]
Description=AlvioRelay WebRTC SFU Media Infrastructure
Documentation=https://github.com/Piyoxz/alviorelay
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alvio
Group=alvio
WorkingDirectory=/etc/alvio
ExecStart=/usr/local/bin/alvio-relay start --config /etc/alvio/alvio-relay.toml
Restart=always
RestartSec=5s

# High-concurrency WebRTC limits
LimitNOFILE=1048576
LimitNPROC=512000
LimitMEMLOCK=infinity

# Security & Sandboxing
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/alvio /var/recordings/alvio
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Standard Output to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=alvio-relay

[Install]
WantedBy=multi-user.target
